# 小苏 · 环境变量模板
# 复制为 .env 后填写（.env 已被 gitignore，绝不入库）

# --- LLM（OpenAI 兼容接口，多供应商）---
# 默认激活的供应商：deepseek / zhipu / dashscope（可在 Web 后台运行时切换）
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 智谱 GLM
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# 阿里通义千问
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 旧版单供应商配置（兼容；供应商未单独配置时回退）
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# --- LLM 调用容错 ---
# 单次请求超时时间（秒）与失败重试次数
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- 钉钉 Stream 模式机器人 ---
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# --- 企业微信（自建应用回调模式）---
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=

# --- 飞书（WebSocket 长连接）---
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# --- 运行环境 ---
APP_ENV=dev
